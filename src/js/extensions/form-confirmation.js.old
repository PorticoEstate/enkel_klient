/**
 * FormConfirmation Extension - Modular Entry Point
 * Handles WCAG 3.3.4 confirmation features (summary and dialogs)
 * 
 * This file uses a modular architecture for better maintainability.
 * The functionality is split across multiple modules:
 * - form-confirmation-core.js: Core logic and initialization
 * - form-confirmation-ui.js: UI generation and styling
 * - form-confirmation-phases.js: Two-phase submission handling
 * - form-confirmation-uploads.js: File upload functionality
 */

// Define the class only if it doesn't exist already
var FormConfirmationExtension = FormConfirmationExtension || (function() {
  return class FormConfirmationExtension {
    constructor(formHandler, options = {}) {
      this.formHandler = formHandler;
      this.$form = formHandler.getForm();
      this.options = {
        showSummary: false,
        showDialog: false,
        ...options
      };
      
      // Form state tracking
      this.recordId = null;
      this.isFormLocked = false;
      this.formData = null;
      this.$currentModal = null;
      
      // Load and apply modular components
      this.loadModules();
      
      // Initialize immediately since we have formHandler
      this.init();
    }
    
    loadModules() {
      // Debug: Check what modules are available
      Debug.debug('FormConfirmation: Checking module availability:', {
        core: typeof FormConfirmationCore !== 'undefined',
        ui: typeof FormConfirmationUI !== 'undefined', 
        phases: typeof FormConfirmationPhases !== 'undefined',
        uploads: typeof FormConfirmationUploads !== 'undefined'
      });
      
      // Apply core functionality
      if (typeof FormConfirmationCore !== 'undefined') {
        Object.assign(this, FormConfirmationCore);
        Debug.debug('FormConfirmation: Core module loaded');
      } else {
        Debug.warn('FormConfirmation: Core module not found - make sure form-confirmation-core.js is included');
      }
      
      // Apply UI functionality  
      if (typeof FormConfirmationUI !== 'undefined') {
        Object.assign(this, FormConfirmationUI);
        Debug.debug('FormConfirmation: UI module loaded');
      } else {
        Debug.warn('FormConfirmation: UI module not found - make sure form-confirmation-ui.js is included');
      }
      
      // Apply phases functionality
      if (typeof FormConfirmationPhases !== 'undefined') {
        Object.assign(this, FormConfirmationPhases);
        Debug.debug('FormConfirmation: Phases module loaded');
      } else {
        Debug.warn('FormConfirmation: Phases module not found - make sure form-confirmation-phases.js is included');
      }
      
      // Apply uploads functionality
      if (typeof FormConfirmationUploads !== 'undefined') {
        Object.assign(this, FormConfirmationUploads);
        Debug.debug('FormConfirmation: Uploads module loaded');
      } else {
        Debug.warn('FormConfirmation: Uploads module not found - make sure form-confirmation-uploads.js is included');
      }
      
      Debug.debug('FormConfirmation: All available modules loaded successfully');
    }
    
    init() {
      // Initialize form confirmation features  
      if (this.options.showSummary || this.options.showDialog) {
        if (this.setupConfirmationFlow && typeof this.setupConfirmationFlow === 'function') {
          this.setupConfirmationFlow();
        } else {
          console.warn('FormConfirmation: Core module not loaded, confirmation flow disabled');
        }
      }
      
      // Make sure styles are added early
      if (this.options.showSummary) {
        if (this.addStyles && typeof this.addStyles === 'function') {
          this.addStyles();
        } else {
          console.warn('FormConfirmation: UI module not loaded, styles not added');
        }
      }
    }
  };
})();

// Export for module systems
if (typeof module !== 'undefined' && module.exports) {
  module.exports = FormConfirmationExtension;
} else {
  window.FormConfirmationExtension = FormConfirmationExtension;
}

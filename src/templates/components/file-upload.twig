{% if enable_fileupload == 1 %}
	<div class="form-group mt-4">
		<label for="fileupload" id="fileupload-label">{{ __('upload_file') }}</label>
		<small id="fileuploadHelp" class="form-text text-muted d-block mb-2">{{ __('upload_instructions') }}</small>
		<div id="drop-area" aria-live="polite">
			<div style="border: 2px dashed #ccc; padding: 20px;">
				<p id="upload-instructions">{{ __('upload_instructions') }}</p>
				<div class="fileupload-buttonbar" role="group" aria-labelledby="upload-instructions">
					<div class="fileupload-buttons">
						<!-- Accessible file upload button that triggers the hidden file input -->
						<button type="button" class="btn btn-success file-select-btn" id="file-select-btn" aria-describedby="fileuploadHelp fileupload-keyboard-hint">
							<i class="fas fa-plus" aria-hidden="true"></i>
							<span>{{ __('add_files') }}</span>
						</button>
						<input id="fileupload" tabindex="-1" type="file" name="files[]" multiple data-droparea="drop-area" style="position: absolute; left: -9999px; opacity: 0; width: 0; height: 0; overflow: hidden;" aria-labelledby="fileupload-label">
						<small id="fileupload-keyboard-hint" class="form-text text-muted d-block mt-1">
							{{ __('press_enter_to_select_files') }} 
							<span>{{ __('keyboard_access_hint') }}</span>
						</small>
						<span class="fileupload-process"></span>
					</div>
					<div class="fileupload-count">
						{{ __('number_of_files') }}:
						<span id="files-count" aria-live="polite">0</span>
					</div>
					<div class="fileupload-progress" style="display:none">
						<div id="progress" class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
						<div class="progress-extended" aria-live="polite"></div>
					</div>
				</div>
				<div class="content_upload_download">
					<div class="presentation files" style="display: block; width: 100%;" aria-live="polite"></div>
				</div>
			</div>
		</div>
	</div>
{% endif %}

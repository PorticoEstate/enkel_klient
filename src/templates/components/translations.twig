{# 
  Shared translations component for all forms
  Usage: {% include 'components/translations.twig' with {'formType': 'helpdesk'} %}
#}
<script>
// Create translations object for JavaScript
var translations = {
    // Core form translations
    field_required: "{{ __('field_required', 'form') }}",
    form_errors_heading: "{{ __('form_errors_heading', 'form') }}",
    form_validation_errors: "{{ __('form_validation_errors', 'form') }}",
    uploading_files: "{{ __('uploading_files', 'form') }}",
    form_submitted: "{{ __('form_submitted', 'form') }}",
    
    // File upload translations (comprehensive set for all forms)
    file_upload: {
        file_too_large: "{{ __('file_too_large', 'file_upload') }}",
        file_empty: "{{ __('file_empty', 'file_upload') }}",
        file_too_small: "{{ __('file_too_small', 'file_upload') }}",
        file_no_extension: "{{ __('file_no_extension', 'file_upload') }}",
        file_type_not_supported: "{{ __('file_type_not_supported', 'file_upload') }}",
        file_dangerous_type: "{{ __('file_dangerous_type', 'file_upload') }}",
        file_invalid_name: "{{ __('file_invalid_name', 'file_upload') }}",
        file_name_too_long: "{{ __('file_name_too_long', 'file_upload') }}",
        file_upload_failed: "{{ __('file_upload_failed', 'file_upload') }}",
        file_validation_error: "{{ __('file_validation_error', 'file_upload') }}",
        upload_in_progress: "{{ __('upload_in_progress', 'file_upload') }}",
        max_files_exceeded: "{{ __('max_files_exceeded', 'file_upload') }}",
        drag_drop_here: "{{ __('drag_drop_here', 'file_upload') }}",
        file_duplicate: "{{ __('file_duplicate', 'file_upload') }}",
        file_upload_error: "{{ __('file_upload_error', 'file_upload') }}"
    },
    
    // Form confirmation translations (WCAG 3.3.4 Error Prevention)
    form_confirmation: {
        review_title: "{{ __('review_title', 'form_confirmation') }}",
        review_intro: "{{ __('review_intro', 'form_confirmation') }}",
        confirm_title: "{{ __('confirm_title', 'form_confirmation') }}",
        edit_button: "{{ __('edit_button', 'form_confirmation') }}",
        edit_all_button: "{{ __('edit_all_button', 'form_confirmation') }}",
        submit_button: "{{ __('submit_button', 'form_confirmation') }}",
        cancel_button: "{{ __('cancel_button', 'form_confirmation') }}",
        yes_submit_button: "{{ __('yes_submit_button', 'form_confirmation') }}",
        close_summary: "{{ __('close_summary', 'form_confirmation') }}",
        uploaded_files: "{{ __('uploaded_files', 'form_confirmation') }}",
        
        {# Form-specific confirmation messages #}
        {% if formType is defined %}
            {{ formType }}_confirm: "{{ __( formType ~ '_confirm', 'form_confirmation') }}",
        {% endif %}
        
        {# Common confirmation messages for all forms #}
        helpdesk_confirm: "{{ __('helpdesk_confirm', 'form_confirmation') }}",
        nokkelbestilling_confirm: "{{ __('nokkelbestilling_confirm', 'form_confirmation') }}",
        inspection_confirm: "{{ __('inspection_confirm', 'form_confirmation') }}",
        invoicerequest_confirm: "{{ __('invoicerequest_confirm', 'form_confirmation') }}",
        
        {# Screen reader and accessibility announcements #}
        summary_opened: "{{ __('summary_opened', 'form_confirmation') }}",
        summary_closed: "{{ __('summary_closed', 'form_confirmation') }}",
        confirmation_opened: "{{ __('confirmation_opened', 'form_confirmation') }}",
        confirmation_closed: "{{ __('confirmation_closed', 'form_confirmation') }}",
        field_focused: "{{ __('field_focused', 'form_confirmation') }}",
        form_being_submitted: "{{ __('form_being_submitted', 'form_confirmation') }}",
        draft_saved: "{{ __('draft_saved', 'form_confirmation') }}",
        draft_restored: "{{ __('draft_restored', 'form_confirmation') }}",
        changes_detected: "{{ __('changes_detected', 'form_confirmation') }}"
    }
};

// Form configuration for WCAG 3.3.4 Error Prevention
window.formConfigs = window.formConfigs || {};
{% if formType is defined and config[formType] is defined %}
window.formConfigs['{{ formType }}'] = {
    form_summary_on_submit: {{ config[formType].form_summary_on_submit|default(false) ? 'true' : 'false' }},
    confirmation_dialog_enabled: {{ config[formType].confirmation_dialog_enabled|default(false) ? 'true' : 'false' }},
    auto_save_enabled: {{ config[formType].auto_save_enabled|default(true) ? 'true' : 'false' }},
    change_tracking_enabled: {{ config[formType].change_tracking_enabled|default(true) ? 'true' : 'false' }},
    enable_fileupload: {{ config[formType].enable_fileupload|default(false) ? 'true' : 'false' }}
};
console.log("Form configuration for {{ formType }}:", window.formConfigs['{{ formType }}']);
{% endif %}
</script>

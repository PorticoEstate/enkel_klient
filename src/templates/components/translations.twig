        draft_saved: "{{ __('draft_saved', 'form_confirmation') }}",
        draft_restored: "{{ __('draft_restored', 'form_confirmation') }}",
        changes_detected: "{{ __('changes_detected', 'form_confirmation') }}"
    }
};

// Form configuration for WCAG 3.3.4 Error Prevention
window.formConfigs = window.formConfigs || {};
{% if formType is defined and config[formType] is defined %}
window.formConfigs['{{ formType }}'] = {
    form_summary_on_submit: {{ config[formType].form_summary_on_submit|default(false) ? 'true' : 'false' }},
    confirmation_dialog_enabled: {{ config[formType].confirmation_dialog_enabled|default(false) ? 'true' : 'false' }},
    auto_save_enabled: {{ config[formType].auto_save_enabled|default(true) ? 'true' : 'false' }},
    change_tracking_enabled: {{ config[formType].change_tracking_enabled|default(true) ? 'true' : 'false' }},
    enable_fileupload: {{ config[formType].enable_fileupload|default(false) ? 'true' : 'false' }}
};
console.log("Form configuration for {{ formType }}:", window.formConfigs['{{ formType }}']);
{% endif %}
</script>

        file_upload_failed: "{{ __('file_upload_failed', 'file_upload') }}",
        file_validation_error: "{{ __('file_validation_error', 'file_upload') }}",
        upload_in_progress: "{{ __('upload_in_progress', 'file_upload') }}",
        max_files_exceeded: "{{ __('max_files_exceeded', 'file_upload') }}",
        drag_drop_here: "{{ __('drag_drop_here', 'file_upload') }}",
        file_duplicate: "{{ __('file_duplicate', 'file_upload') }}",
        file_upload_error: "{{ __('file_upload_error', 'file_upload') }}"
    },
    
    // Form confirmation translations (WCAG 3.3.4 Error Prevention)
    form_confirmation: {
        review_title: "{{ __('review_title', 'form_confirmation') }}",
        review_intro: "{{ __('review_intro', 'form_confirmation') }}",
        confirm_title: "{{ __('confirm_title', 'form_confirmation') }}",
        edit_button: "{{ __('edit_button', 'form_confirmation') }}",
        edit_all_button: "{{ __('edit_all_button', 'form_confirmation') }}",
        submit_button: "{{ __('submit_button', 'form_confirmation') }}",

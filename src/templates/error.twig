{# filepath: /home/hc483/public_html/enkel_klient/src/templates/error.twig #}
{% extends 'head.twig' %}

{% block body %}
	<div class="container mt-5">
		<div class="row justify-content-center">
			<div class="col-md-8">
				<div class="card">
					<div class="card-header bg-danger text-white">
						<h4 class="mb-0">
							<i class="fas fa-exclamation-triangle me-2"></i>
							{{__('error')}}
							{{ error_code }}
						</h4>
					</div>
					<div class="card-body">
						<p class="mb-4">{{ error_message }}</p>

						{% if error_trace is defined %}
							<div class="mt-4 mb-4">
								<h5>Error details:</h5>
								<p><strong>File:</strong> {{ error_file }} (line {{ error_line }})</p>
								<div class="bg-light p-3" style="overflow-x: auto;">
									<pre style="white-space: pre-wrap;">{{ error_trace }}</pre>
								</div>
							</div>
						{% endif %}

						<div class="d-flex justify-content-between align-items-center">
							<a href="{{ base_path }}/" class="btn btn-primary">
								<i class="fas fa-home me-2"></i>{{ __('go_to_homepage') }}
							</a>

							<button class="btn btn-outline-secondary" onclick="window.history.back();">
								<i class="fas fa-arrow-left me-2"></i>{{ __('go_back') }}
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

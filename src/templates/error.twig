{% extends 'head.twig' %}

{% block body %}
	<div class="container mt-5">
		<div class="row justify-content-center">
			<div class="col-md-8">
				<main
				<div class="card">
					<div class="card-header bg-danger text-white">
						<h1 class="mb-0">
							<i class="fas fa-exclamation-triangle me-2" aria-hidden="true"></i>
							{{__('error')}}
							{{ error_code }}
						</h1>
					</div>
					<div class="card-body">
						<p class="mb-4">{{ error_message }}</p>

						{% if error_trace is defined %}
							<section class="mt-4 mb-4" aria-labelledby="error-details">
								<h2 id="error-details" class="h4">Error details:</h2>
								<p><strong>File:</strong> <span>{{ error_file }}</span> (line <span>{{ error_line }}</span>)</p>
								<div class="bg-light p-3" style="overflow-x: auto;" aria-label="Error stack trace">
									<pre style="white-space: pre-wrap;">{{ error_trace }}</pre>
								</div>
							</section>
						{% endif %}

						<div class="d-flex justify-content-between align-items-center">
							<a href="{{ base_path }}/" class="btn btn-primary">
								<i class="fas fa-home me-2" aria-hidden="true"></i>{{ __('go_to_homepage') }}
							</a>

							<button class="btn btn-outline-secondary" id="back-button">
								<i class="fas fa-arrow-left me-2" aria-hidden="true"></i>{{ __('go_back') }}
							</button>
						</div>
					</div>
				</div>
				</main>
			</div>
		</div>
	</div>
	
	<!-- Common styles moved to src/css/common.css -->
	
	<script>
		document.addEventListener('DOMContentLoaded', function() {
			// Make the back button accessible with proper event listener instead of inline onclick
			document.getElementById('back-button').addEventListener('click', function() {
				window.history.back();
			});
			
			// Add keyboard handling for common actions
			document.addEventListener('keydown', function(e) {
				// Allow Escape key to go back
				if (e.key === 'Escape') {
					window.history.back();
				}
			});
		});
	</script>
{% endblock %}

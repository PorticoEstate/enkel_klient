{% extends 'head.twig' %}

{% block body %}
	<script src="{{ base_path }}/vendor/components/jquery/jquery.min.js?n={{ cache_refresh_token }}"></script>
	
	<!-- Main Quill library -->
	<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
	<script src="{{ base_path }}/src/js/quill-textarea.js?n={{ cache_refresh_token }}"></script>
	
	<!-- JS translations -->
	<script>
		// Create translations object for JavaScript
		var translations = {
			field_required: "{{ __('field_required', 'form') }}",
			form_errors_heading: "{{ __('form_errors_heading', 'form') }}",
			form_validation_errors: "{{ __('form_validation_errors', 'form') }}",
			uploading_files: "{{ __('uploading_files', 'form') }}",
			form_submitted: "{{ __('form_submitted', 'form') }}",
			file_upload: {
				file_too_large: "{{ __('file_too_large', 'file_upload') }}",
				file_empty: "{{ __('file_empty', 'file_upload') }}",
				file_too_small: "{{ __('file_too_small', 'file_upload') }}",
				file_no_extension: "{{ __('file_no_extension', 'file_upload') }}",
				file_type_not_supported: "{{ __('file_type_not_supported', 'file_upload') }}",
				file_dangerous_type: "{{ __('file_dangerous_type', 'file_upload') }}",
				file_invalid_name: "{{ __('file_invalid_name', 'file_upload') }}",
				file_name_too_long: "{{ __('file_name_too_long', 'file_upload') }}",
				file_upload_failed: "{{ __('file_upload_failed', 'file_upload') }}",
				file_validation_error: "{{ __('file_validation_error', 'file_upload') }}",
				upload_in_progress: "{{ __('upload_in_progress', 'file_upload') }}",
				max_files_exceeded: "{{ __('max_files_exceeded', 'file_upload') }}",
				drag_drop_here: "{{ __('drag_drop_here', 'file_upload') }}"
			},
			form_confirmation: {
				review_title: "{{ __('review_title', 'form_confirmation') }}",
				review_intro: "{{ __('review_intro', 'form_confirmation') }}",
				confirm_title: "{{ __('confirm_title', 'form_confirmation') }}",
				edit_button: "{{ __('edit_button', 'form_confirmation') }}",
				edit_all_button: "{{ __('edit_all_button', 'form_confirmation') }}",
				submit_button: "{{ __('submit_button', 'form_confirmation') }}",
				cancel_button: "{{ __('cancel_button', 'form_confirmation') }}",
				yes_submit_button: "{{ __('yes_submit_button', 'form_confirmation') }}",
				close_summary: "{{ __('close_summary', 'form_confirmation') }}",
				uploaded_files: "{{ __('uploaded_files', 'form_confirmation') }}",
				inspection_confirm: "{{ __('inspection_confirm', 'form_confirmation') }}",
				summary_opened: "{{ __('summary_opened', 'form_confirmation') }}",
				summary_closed: "{{ __('summary_closed', 'form_confirmation') }}",
				confirmation_opened: "{{ __('confirmation_opened', 'form_confirmation') }}",
				confirmation_closed: "{{ __('confirmation_closed', 'form_confirmation') }}",
				field_focused: "{{ __('field_focused', 'form_confirmation') }}",
				form_being_submitted: "{{ __('form_being_submitted', 'form_confirmation') }}",
				draft_saved: "{{ __('draft_saved', 'form_confirmation') }}",
				draft_restored: "{{ __('draft_restored', 'form_confirmation') }}",
				changes_detected: "{{ __('changes_detected', 'form_confirmation') }}"
			}
		};
		
		// Form configuration for WCAG 3.3.4 Error Prevention
		window.formConfigs = window.formConfigs || {};
		window.formConfigs['inspection_1'] = {
			form_summary_on_submit: {{ config.inspection_1.form_summary_on_submit|default(false) ? 'true' : 'false' }},
			confirmation_dialog_enabled: {{ config.inspection_1.confirmation_dialog_enabled|default(true) ? 'true' : 'false' }},
			auto_save_enabled: {{ config.inspection_1.auto_save_enabled|default(true) ? 'true' : 'false' }},
			change_tracking_enabled: {{ config.inspection_1.change_tracking_enabled|default(true) ? 'true' : 'false' }}
		};
		console.log("Form configuration for inspection_1:", window.formConfigs['inspection_1']);
	</script>

	<link href="{{ base_path }}/src/css/jquery-ui.min.css?n={{ cache_refresh_token }}" type="text/css" rel="stylesheet">
	{% if enable_fileupload == 1 %}
		<link href="{{ base_path }}/src/js/file-upload/css/jquery.fileupload.css?n={{ cache_refresh_token }}" type="text/css" rel="stylesheet">
		<link href="{{ base_path }}/src/js/file-upload/css/jquery.fileupload-ui.css?n={{ cache_refresh_token }}" type="text/css" rel="stylesheet">
		<link href="{{ base_path }}/src/js/file-upload/css/jquery.fileupload-custom.css?n={{ cache_refresh_token }}" type="text/css" rel="stylesheet">
	{% endif %}
	<!-- Quill Editor CSS -->
	<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
	<link href="{{ base_path }}/src/css/quill-custom.css?n={{ cache_refresh_token }}" rel="stylesheet">
	<!-- Common styles moved to src/css/common.css -->

	<div class="container">
		<main role="main">
		<h1 id="form-header">{{ __('form_header') }}</h1>

		{% if saved == 1 %}
			<div class="alert alert-success" role="alert" aria-live="polite">
				<p>{{ __('case_registered') }}
					#{{ id }}</p>
			</div>
			<button type="button" class="btn btn-primary mt-2" onclick="refresh_form();" aria-label="{{ __('new_registration') }}">{{ __('new_registration') }}</button>
		{% else %}
			{% if error|length > 0 %}
				<div class="alert alert-danger alert-dismissible" role="alert" aria-live="assertive">
					<h2 class="sr-only">{{ __('Form errors') }}</h2>
					{% for message in error %}
						<p>{{ message }}</p>
					{% endfor %}
				</div>
			{% endif %}
			
			<form id="inspection_1" name="inspection_1" method="post" action="{{ action_url }}" enctype="multipart/form-data" novalidate aria-labelledby="form-header">
				<input type="hidden" value="{{ rand }}" name="randcheck"/>
				<fieldset>
					<legend class="sr-only">{{ __('inspection_details') }}</legend>
					<div class="required-fields-explanation" role="region" aria-labelledby="required-fields-heading">
					  <h2 id="required-fields-heading" class="h6 visually-hidden">{{ __('required_fields_info') }}</h2>
					  <p>
						<span class="required-field" aria-hidden="true">*</span>
						{{ __('indicates_required_fields') }}
					  </p>
					</div>
					<div class="form-group mt-2">
						<label for="location_name" class="required">
							<i class="fas fa-search" aria-hidden="true"></i>
							{{ __('address') }}
						</label>
						<input type="text" id="location_name" name="location_name" class="form-control" autocomplete="street-address" 
									required="required" aria-required="true" aria-describedby="location-error" 
									aria-haspopup="listbox" aria-expanded="false"/>
						<div class="selection" aria-live="polite"></div>
						<input type="hidden" id="location_code" name="location_code">
					</div>
					<div id="details">
						<div class="form-check">
							<input class="form-check-input" type="checkbox" name="values_attribute[7][value]" id="tilgang" value="1" onchange="handleChangeTilgang(this);" aria-controls="inner_details"/>
							<label class="form-check-label" for="tilgang">
								{{ __('missing_access') }}
							</label>
						</div>
						<div id="inner_details">
							<fieldset id="slukkeutstyr" class="form-group mt-2">
								<legend>{{ __('fire_equipment') }}</legend>
								<div class="form-check">
									<input class="form-check-input" type="radio" name="values_attribute[2][value][]" id="type_br_slokking_2" value="2" required="required" onchange="handleChangeSlukkeutstyr(this);" aria-required="true"/>
									<label class="form-check-label" for="type_br_slokking_2">
										{{ __('fire_hose') }}
									</label>
								</div>
								<div class="form-check">
									<input class="form-check-input" type="radio" name="values_attribute[2][value][]" id="type_br_slokking_3" value="3" required="required" onchange="handleChangeSlukkeutstyr(this);" aria-required="true"/>
									<label class="form-check-label" for="type_br_slokking_3">
										{{ __('powder') }}
									</label>
								</div>
								<div class="form-check">
									<input class="form-check-input" type="radio" name="values_attribute[2][value][]" id="type_br_slokking_4" value="4" required="required" onchange="handleChangeSlukkeutstyr(this);" aria-required="true"/>
									<label class="form-check-label" for="type_br_slokking_4">
										{{ __('foam') }}
									</label>
								</div>
								<div class="form-check">
									<input class="form-check-input" type="radio" name="values_attribute[2][value][]" id="type_br_slokking_1" value="1" required="required" onchange="handleChangeSlukkeutstyr(this);" aria-required="true"/>
									<label class="form-check-label" for="type_br_slokking_1">
										{{ __('changed_extinguisher') }}
									</label>
								</div>
							</fieldset>

							<div id="dateblock" class="form-group mt-2" style="display: none;" aria-hidden="true">
								<label for="datestamp">{{ __('date_stamp_extinguisher') }}</label>
								<!--the parsed value is always formatted yyyy-mm-dd.-->
								<input id="datestamp" type="date" class="form-control" name="values_attribute[1][value]" aria-describedby="datestampHelp"/>
								<small id="datestampHelp" class="form-text text-muted">{{ __('date_format_yyyy_mm_dd') }}</small>
							</div>

							<fieldset class="form-group mt-2">
								<legend>{{ __('smoke_detector') }}</legend>
								<div class="form-check">
									<input class="form-check-input" type="radio" name="values_attribute[3][value][]" id="rokvarsler_1" value="1" required="required" aria-required="true"/>
									<label class="form-check-label" for="rokvarsler_1">
										{{ __('checked_ok') }}
									</label>
								</div>
								<div class="form-check">
									<input class="form-check-input" type="radio" name="values_attribute[3][value][]" id="rokvarsler_2" value="2" required="required" aria-required="true"/>
									<label class="form-check-label" for="rokvarsler_2">
										{{ __('changed_battery') }}
									</label>
								</div>
								<div class="form-check">
									<input class="form-check-input" type="radio" name="values_attribute[3][value][]" id="rokvarsler_3" value="3" required="required" aria-required="true"/>
									<label class="form-check-label" for="rokvarsler_3">
										{{ __('changed_detector') }}
									</label>
								</div>
								<div class="form-check">
									<input class="form-check-input" type="radio" name="values_attribute[3][value][]" id="rokvarsler_4" value="1" required="required" aria-required="true"/>
									<label class="form-check-label" for="rokvarsler_4">
										{{ __('part_of_alarm_system') }}
									</label>
								</div>
							</fieldset>
						</div>

						<fieldset class="form-group mt-2">
							<legend>{{ __('important_note') }}</legend>
							<div class="form-check">
								<input class="form-check-input" type="checkbox" name="values_attribute[4][value]" id="id_behov_tilsyn" value="1" aria-describedby="tilsynHelp"/>
								<label class="form-check-label" for="id_behov_tilsyn">
									{{ __('need_extended_inspection') }}
								</label>
								<small id="tilsynHelp" class="form-text text-muted d-block">{{ __('check_if_extended_inspection_needed') }}</small>
							</div>
						</fieldset>

						<div id="hidden_div" class="form-group mt-2">
							<label for="merknad">{{ __('remark') }}</label>
							<small id="merknadHelp" class="form-text text-muted">{{ __('remark_help') }}</small>
							<textarea class="form-control" id="merknad" rows="8" aria-describedby="merknadHelp" name="values_attribute[5][value]" data-quilljs="true"></textarea>
						</div>
						{% include 'components/file-upload.twig' with {
							'required': false
						} %}
						<button id="submit" type="submit" class="btn btn-primary mt-2">
							<i class="far fa-paper-plane" aria-hidden="true"></i>
							{{ __('send') }}
						</button>
						<div id="form-submission-status" class="sr-only" aria-live="assertive"></div>
					</div>
				</fieldset>
			</form>
		{% endif %}
		</main>
	</div>
	<script>
		function refresh_form() {
			window.location.replace(`{{ str_base_url }}/inspection_1`);
		}
		var schema = 'inspection_1';
	</script>

	{% if saved != 1 %}
		<!-- MIGRATED TO CLEAN ARCHITECTURE: Reduced from 1,950+ lines to ~580 lines -->
		
		<!-- CLEAN ARCHITECTURE: Core form handler + extension system -->
		<script src="{{ base_path }}/src/js/form-handler-core.js?n={{ cache_refresh_token }}"></script>
		<script src="{{ base_path }}/src/js/form-extension-loader.js?n={{ cache_refresh_token }}"></script>

		<!-- Load only needed extensions (77% reduction in code) -->
		<script src="{{ base_path }}/src/js/extensions/form-validation.js?n={{ cache_refresh_token }}"></script>
		<script src="{{ base_path }}/src/js/extensions/form-accessibility.js?n={{ cache_refresh_token }}"></script>
		<script src="{{ base_path }}/src/js/extensions/form-autosave.js?n={{ cache_refresh_token }}"></script>
		<script src="{{ base_path }}/src/js/extensions/form-confirmation.js?n={{ cache_refresh_token }}"></script>
		
		<!-- jQuery UI Core and Widget Factory - CDN version for compatibility -->
		<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js" integrity="sha256-lSjKY0/srUM9BE3dPm+c4fBo1dky2v27Gdjm2uoZaL0=" crossorigin="anonymous"></script>
		
		{% if enable_fileupload == 1 %}
			<!-- File upload dependencies and extension -->
			<script src="{{ base_path }}/src/js/file-upload/js/jquery.fileupload.js?n={{ cache_refresh_token }}"></script>
			<script src="{{ base_path }}/src/js/file-upload/js/jquery.fileupload-process.js?n={{ cache_refresh_token }}"></script>
			<script src="{{ base_path }}/src/js/file-upload/js/jquery.fileupload-validate.js?n={{ cache_refresh_token }}"></script>
			<script src="{{ base_path }}/src/js/extensions/file-upload.js?n={{ cache_refresh_token }}"></script>
		{% endif %}
		
		<!-- Location and autocomplete functionality -->
		<script src="{{ base_path }}/src/js/autocomplete/autoComplete.js?n={{ cache_refresh_token }}"></script>
		<script src="{{ base_path }}/src/js/location.js?n={{ cache_refresh_token }}"></script>
		
		<!-- MIGRATED: Clean inspection form handler -->
		<script src="{{ base_path }}/src/js/inspection_1-migrated.js?n={{ cache_refresh_token }}"></script>
	{% endif %}
{% endblock %}

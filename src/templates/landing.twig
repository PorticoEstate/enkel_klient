{% extends 'head.twig' %}

{% block body %}
	<!-- Skip link for keyboard navigation -->
	<a href="#main-content" class="skip-link">{{ __('Skip to content') }}</a>
	
	<div class="container mt-5">
		<div class="row justify-content-center">
			<div class="col-md-12 text-center">
				<main id="main-content">
				<h1 class="mb-4">{{ __('title', 'landing') }}</h1>
				<h2 class="h4 mb-3">{{ __('subtitle', 'landing') }}</h2>
				<p class="lead mb-5">{{ __('description', 'landing') }}</p>
				<div class="row mt-4">
					{% if config.services.helpdesk %}
						<div class="col-md-4 mb-4">
							<div class="card h-100 hover-shadow focus-shadow">
								<div class="card-body">
									<i class="fas fa-ticket-alt fa-2x mb-3 text-primary" aria-hidden="true"></i>
									<h3 class="h5 card-title text-nowrap">{{ __('title', 'helpdesk') }}</h3>
									<p class="card-text text-dark">{{ __('description', 'helpdesk') }}</p>
									<div class="mt-3">
										<a href="{{ str_base_url }}/helpdesk" class="stretched-link btn btn-outline-primary" aria-label="{{ __('title', 'helpdesk') }}: {{ __('description', 'helpdesk') }}">
											{{ __('open_service', 'common') }}
										</a>
									</div>
								</div>
							</div>
						</div>
					{% endif %}
					{% if config.services.nokkelbestilling %}
						<div class="col-md-4 mb-4">
							<div class="card h-100 hover-shadow focus-shadow">
								<div class="card-body">
									<i class="fas fa-key fa-2x mb-3 text-primary" aria-hidden="true"></i>
									<h3 class="h5 card-title text-nowrap">{{ __('title', 'nokkelbestilling') }}</h3>
									<p class="card-text text-dark">{{ __('description', 'nokkelbestilling') }}</p>
									<div class="mt-3">
										<a href="{{ str_base_url }}/nokkelbestilling" class="stretched-link btn btn-outline-primary" aria-label="{{ __('title', 'nokkelbestilling') }}: {{ __('description', 'nokkelbestilling') }}">
											{{ __('open_service', 'common') }}
										</a>
									</div>
								</div>
							</div>
						</div>
					{% endif %}
					{% if config.services.invoicerequest %}
						<div class="col-md-4 mb-4">
							<div class="card h-100 hover-shadow focus-shadow">
								<div class="card-body">
									<i class="fas fa-file-invoice fa-2x mb-3 text-primary" aria-hidden="true"></i>
									<h3 class="h5 card-title text-nowrap">{{ __('title', 'invoicerequest') }}</h3>
									<p class="card-text text-dark">{{ __('description', 'invoicerequest') }}</p>
									<div class="mt-3">
										<a href="{{ str_base_url }}/invoicerequest" class="stretched-link btn btn-outline-primary" aria-label="{{ __('title', 'invoicerequest') }}: {{ __('description', 'invoicerequest') }}">
											{{ __('open_service', 'common') }}
										</a>
									</div>
								</div>
							</div>
						</div>
					{% endif %}
					{% if config.services.inspection_1 %}
						<div class="col-md-4 mb-4">
							<div class="card h-100 hover-shadow focus-shadow">
								<div class="card-body">
									<i class="fas fa-clipboard-check fa-2x mb-3 text-primary" aria-hidden="true"></i>
									<h3 class="h5 card-title text-nowrap">{{ __('title', 'inspection_1') }}</h3>
									<p class="card-text text-dark">{{ __('description', 'inspection_1') }}</p>
									<div class="mt-3">
										<a href="{{ str_base_url }}/inspection_1" class="stretched-link btn btn-outline-primary" aria-label="{{ __('title', 'inspection_1') }}: {{ __('description', 'inspection_1') }}">
											{{ __('open_service', 'common') }}
										</a>
									</div>
								</div>
							</div>
						</div>
					{% endif %}
				</div>
				</main>
			</div>
		</div>
	</div>

	<style>
		/* Skip link for keyboard navigation */
		.skip-link {
			position: absolute;
			top: -40px;
			left: 0;
			background: #0d6efd;
			color: white;
			padding: 8px;
			z-index: 100;
			transition: top 0.2s ease;
		}
		
		.skip-link:focus {
			top: 0;
			outline: 2px solid #4a90e2;
		}
		
		/* Card hover and focus effects */
		.hover-shadow:hover {
			box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
			transform: translateY(-3px);
			transition: all 0.2s ease-in-out;
		}
		
		/* Focus styles for keyboard navigation */
		.focus-shadow:focus-within {
			box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
			transform: translateY(-3px);
			outline: 2px solid #4a90e2;
		}
		
		/* Ensure all interactive elements have visible focus */
		a:focus, button:focus {
			outline: 2px solid #4a90e2 !important;
			outline-offset: 2px;
		}
		
		/* Make stretched links properly accessible */
		.stretched-link::after {
			position: absolute;
			top: 0;
			right: 0;
			bottom: 0;
			left: 0;
			z-index: 1;
			content: "";
		}
		
		/* Make cards tabbable */
		.card {
			position: relative;
		}
	</style>
	
	{# Add screen reader announcer for any dynamic content #}
	<div id="sr-announcer" class="sr-only" aria-live="polite"></div>
{% endblock %}

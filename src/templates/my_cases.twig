{# filepath: /home/hc483/public_html/enkel_klient/src/templates/my_cases.twig #}
{% extends 'head.twig' %}

{% block body %}
	<style>
		/* Accessibility styles */
		.skip-link {
			position: absolute;
			top: -40px;
			left: 0;
			background: #000;
			color: white;
			padding: 8px;
			z-index: 100;
			transition: top 0.3s;
		}
		
		.skip-link:focus {
			top: 0;
		}
		
		/* Focus styling */
		a:focus, button:focus, input:focus, select:focus, textarea:focus {
			outline: 2px solid #4a90e2;
			outline-offset: 2px;
		}
		
		/* Screen reader only text */
		.sr-only {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			border: 0;
		}
		
		/* Improve table row hover focus */
		.table-hover tr:hover {
			background-color: rgba(0, 0, 0, 0.075);
		}
		
		tr.clickable:focus {
			outline: 2px solid #4a90e2;
			outline-offset: -2px;
		}
		
		/* Better contrast for badges */
		.badge.bg-warning {
			color: #000 !important;
		}
		
		.badge.bg-info {
			color: #000 !important;
		}
	</style>

	<!-- Skip link for keyboard navigation -->
	<a href="#main-content" class="skip-link">{{ __('Skip to content') }}</a>

	<div class="container mt-4">
		<main id="main-content" role="main">
		<h1 class="mb-4">{{ __('my_cases') }}</h1>

		<section aria-label="{{ __('user_information') }}">
			<div class="card mb-4">
				<div class="card-body">
					<h2 class="h5 card-title">{{ __('user_info') }}</h2>
					<p class="card-text">{{ __('name') }}:
						{{ user_name }}</p>
					{% if user_email %}
						<p class="card-text">{{ __('email') }}:
							{{ user_email }}</p>
					{% endif %}
				</div>
			</div>
		</section>

		{% if result and result.results and result.results|length > 0 %}
			<section aria-label="{{ __('your_cases_list') }}">
				<div class="table-responsive">
					<table class="table table-striped table-hover" aria-describedby="cases-table-desc">
						<caption id="cases-table-desc" class="sr-only">{{ __('list_of_your_cases') }}</caption>
						<thead class="table-light">
							<tr>
								{# Sortable ID column #}
								<th scope="col">
									<a href="{{ base_path }}/my_cases?sort=id&dir={{ result.sort == 'id' and result.dir == 'asc' ? 'desc' : 'asc' }}&start={{ result.start }}" class="text-decoration-none text-dark" aria-label="{{ __('sort_by_id') }} {{ result.sort == 'id' ? (result.dir == 'asc' ? __('sorted_ascending') : __('sorted_descending')) : '' }}">
										#
										{% if result.sort == 'id' %}
											<i class="fas fa-sort-{{ result.dir == 'asc' ? 'up' : 'down' }} ms-1" aria-hidden="true"></i>
										{% else %}
											<i class="fas fa-sort text-muted ms-1" aria-hidden="true"></i>
										{% endif %}
									</a>
								</th>

							{# Sortable Registration Date column #}
							<th scope="col">
								<a href="{{ base_path }}/my_cases?sort=entry_date&dir={{ result.sort == 'entry_date' and result.dir == 'asc' ? 'desc' : 'asc' }}&start={{ result.start }}" class="text-decoration-none text-dark" aria-label="{{ __('sort_by_registration_date') }} {{ result.sort == 'entry_date' ? (result.dir == 'asc' ? __('sorted_ascending') : __('sorted_descending')) : '' }}">
									{{ __('registered_date') }}
									{% if result.sort == 'entry_date' %}
										<i class="fas fa-sort-{{ result.dir == 'asc' ? 'up' : 'down' }} ms-1" aria-hidden="true"></i>
									{% else %}
										<i class="fas fa-sort text-muted ms-1" aria-hidden="true"></i>
									{% endif %}
								</a>
							</th>

							{# Non-sortable Subject column #}
							<th scope="col">{{ __('subject') }}</th>

							{# Sortable Last Updated column #}
							<th scope="col">
								<a href="{{ base_path }}/my_cases?sort=modified_date&dir={{ result.sort == 'modified_date' and result.dir == 'asc' ? 'desc' : 'asc' }}&start={{ result.start }}" class="text-decoration-none text-dark" aria-label="{{ __('sort_by_last_updated') }} {{ result.sort == 'modified_date' ? (result.dir == 'asc' ? __('sorted_ascending') : __('sorted_descending')) : '' }}">
									{{ __('last_updated') }}
									{% if result.sort == 'modified_date' %}
										<i class="fas fa-sort-{{ result.dir == 'asc' ? 'up' : 'down' }} ms-1" aria-hidden="true"></i>
									{% else %}
										<i class="fas fa-sort text-muted ms-1" aria-hidden="true"></i>
									{% endif %}
								</a>
							</th>

							{# Non-sortable columns #}
							<th scope="col">{{ __('status') }}</th>
							<th scope="col">{{ __('action') }}</th>
						</tr>
					</thead>
					<tbody>
						{% for case in result.results %}
							<tr class="clickable" tabindex="0" aria-label="{{ __('case') }} {{ case.id }}: {{ case.subject }}" data-case-url="{{ base_path }}/view_case/{{ case.id }}">
								<td>{{ case.id }}</td>
								<td>
									{% if case.registered_date is defined %}
										<time datetime="{{ case.registered_date|date('Y-m-d\\TH:i:s') }}">{{ case.registered_date|date('d.m.Y H:i') }}</time>
									{% elseif case.entry_date is defined %}
										<time datetime="{{ case.entry_date|date('Y-m-d\\TH:i:s') }}">{{ case.entry_date|date('d.m.Y H:i') }}</time>
									{% else %}
										-
									{% endif %}
								</td>
								<td>{{ case.subject }}</td>
								<td>
									{% if case.status_change_date is defined %}
										<time datetime="{{ case.status_change_date|date('Y-m-d\\TH:i:s') }}">{{ case.status_change_date|date('d.m.Y H:i') }}</time>
									{% elseif case.modified_date is defined %}
										<time datetime="{{ case.modified_date|date('Y-m-d\\TH:i:s') }}">{{ case.modified_date|date('d.m.Y H:i') }}</time>
									{% else %}
										-
									{% endif %}
								</td>
								<td>
									{% if case.status == 'O' %}
										<span class="badge bg-success" aria-label="{{ __('status') }}: {{case.status_text}}">{{case.status_text}}</span>
									{% elseif case.status == 'C1' %}
										<span class="badge bg-warning text-dark" aria-label="{{ __('status') }}: {{case.status_text}}">{{case.status_text}}</span>

									{% elseif case.status == 'X' %}
										<span class="badge bg-secondary" aria-label="{{ __('status') }}: {{case.status_text}}">{{case.status_text}}</span>

									{% elseif case.status == 'C' %}
										<span class="badge bg-secondary" aria-label="{{ __('status') }}: {{case.status_text}}">{{case.status_text}}</span>

									{% else %}
										<span class="badge bg-info" aria-label="{{ __('status') }}: {{ case.status_text }}">{{ case.status_text }}</span>

									{% endif %}
								</td>
								<td>
									<a href="{{ base_path }}/view_case/{{ case.id }}" class="btn btn-sm btn-outline-primary" aria-label="{{ __('view_details_for_case') }} {{ case.id }}">
										<i class="fas fa-eye" aria-hidden="true"></i>
										<span>{{ __('view_details') }}</span>
									</a>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			<div class="mt-3 d-flex justify-content-between">
				<p class="text-muted" id="results-summary" aria-live="polite">
					<small>{{ __('showing') }}
						{{ result.start + 1 }}
						-
						{{ result.start + result.results|length }}
						{{ __('of') }}
						{{ result.total_records }}
						{{ __('cases') }}</small>
				</p>

				{% if result.total_records > result.results|length %}
					<nav aria-label="{{ __('case_pagination') }}">
						<ul class="pagination pagination-sm">
							{% if result.start > 0 %}
								<li class="page-item">
									<a class="page-link" href="{{ base_path }}/my_cases?start=0&sort={{ result.sort }}&dir={{ result.dir }}" aria-label="{{ __('first_page') }}">
										<span aria-hidden="true">&laquo;&laquo;</span>
										<span class="sr-only">{{ __('first_page') }}</span>
									</a>
								</li>
								<li class="page-item">
									<a class="page-link" href="{{ base_path }}/my_cases?start={{ result.start - result.perPage }}&sort={{ result.sort }}&dir={{ result.dir }}" aria-label="{{ __('previous_page') }}">
										<span aria-hidden="true">&laquo;</span>
										<span class="sr-only">{{ __('previous_page') }}</span>
									</a>
								</li>
							{% endif %}

							{% if result.start + result.results|length < result.total_records %}
								<li class="page-item">
									<a class="page-link" href="{{ base_path }}/my_cases?start={{ result.start + result.perPage }}&sort={{ result.sort }}&dir={{ result.dir }}" aria-label="{{ __('next_page') }}">
										<span aria-hidden="true">&raquo;</span>
										<span class="sr-only">{{ __('next_page') }}</span>
									</a>
								</li>
								<li class="page-item">
									<a class="page-link" href="{{ base_path }}/my_cases?start={{ result.total_records - result.perPage }}&sort={{ result.sort }}&dir={{ result.dir }}" aria-label="{{ __('last_page') }}">
										<span aria-hidden="true">&raquo;&raquo;</span>
										<span class="sr-only">{{ __('last_page') }}</span>
									</a>
								</li>
							{% endif %}
						</ul>
					</nav>
				{% endif %}
			</div>
			</section>
		{% else %}
			<div class="alert alert-info" role="alert">
				<p>{{ __('no_cases') }}</p>
			</div>
		{% endif %}

		<section aria-labelledby="create-case-heading" class="mt-4">
			<h2 id="create-case-heading" class="h4 mb-3">{{ __('create_new_case') }}</h2>
			<div class="row">
				{% if config.services.helpdesk %}
					<div class="col-md-4 mb-3">
						<div class="d-grid">
							<a href="{{ base_path }}/helpdesk" class="btn btn-outline-primary">
								<i class="fas fa-ticket-alt me-2" aria-hidden="true"></i>
								<span>{{ __('form_header', 'helpdesk') }}</span>
							</a>
						</div>
					</div>
				{% endif %}

				{% if config.services.nokkelbestilling %}
					<div class="col-md-4 mb-3">
						<div class="d-grid">
							<a href="{{ base_path }}/nokkelbestilling" class="btn btn-outline-primary">
								<i class="fas fa-key me-2" aria-hidden="true"></i>
								<span>{{ __('form_header', 'nokkelbestilling') }}</span>
							</a>
						</div>
					</div>
				{% endif %}
				
				{% if config.services.invoicerequest %}
					<div class="col-md-4 mb-3">
						<div class="d-grid">
							<a href="{{ base_path }}/invoicerequest" class="btn btn-outline-primary">
								<i class="fas fa-file-invoice-dollar me-2" aria-hidden="true"></i>
								<span>{{ __('form_header', 'invoicerequest') }}</span>
							</a>
						</div>
					</div>
				{% endif %}
			</div>
		</section>
		</main>
	</div>
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			// Make table rows accessible for keyboard and mouse users
			const rows = document.querySelectorAll('tbody tr.clickable');
			rows.forEach(row => {
				// Handle mouse clicks
				row.addEventListener('click', function(e) {
					if (e.target.tagName !== 'BUTTON' && e.target.tagName !== 'A' && !e.target.closest('a') && !e.target.closest('button')) {
						const url = this.getAttribute('data-case-url');
						if (url) {
							window.location.href = url;
						}
					}
				});
				
				// Handle keyboard events
				row.addEventListener('keydown', function(e) {
					// Activate on Enter or Space
					if (e.key === 'Enter' || e.key === ' ') {
						e.preventDefault();
						const url = this.getAttribute('data-case-url');
						if (url) {
							window.location.href = url;
						}
					}
				});
				
				row.style.cursor = 'pointer';
			});
			
			// Announce page changes for screen readers
			const paginationLinks = document.querySelectorAll('.pagination .page-link');
			paginationLinks.forEach(link => {
				link.addEventListener('click', function() {
					const summaryElement = document.getElementById('results-summary');
					if (summaryElement) {
						summaryElement.setAttribute('aria-live', 'assertive');
					}
				});
			});
		});
	</script>
{% endblock %}
